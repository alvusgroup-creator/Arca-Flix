# ---------------------------------------------------------------------------
# Arca Flix — variáveis de ambiente
# Copie para .env.local. Sem Supabase configurado a app roda em MODO DEMONSTRAÇÃO
# (login com qualquer e-mail, dados em cookies, catálogo de lib/demo).
# ---------------------------------------------------------------------------

# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas servidor — nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers › API keys / Webhooks)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Bunny Stream
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
# Host da pull zone da biblioteca, ex.: vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_CDN_HOST=
# Opcional: chave de "Token Authentication" da pull zone (URLs assinadas).
BUNNY_TOKEN_KEY=

# Resend (e-mails transacionais)
RESEND_API_KEY=
EMAIL_FROM="Arca Flix <no-reply@seudominio.com>"

# URL pública da aplicação (sem barra no fim)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional — mídia usada apenas no modo demonstração
# DEMO_VIDEO_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
# DEMO_AUDIO_URL=https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3
