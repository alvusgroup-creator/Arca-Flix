//   npm run db:youtube
// O vídeo fica em `video_id` como "yt:<id>" (ver lib/bunny.ts › getVideoSource).

export interface YtVideo {
  id: string
  title: string
  channel: string
  duration: string
  /** Temporada (séries); sem valor = 1. */
  season?: number
}

export interface YtTitle {
  slug: string
  title: string
  description: string
  type: "series" | "movie"
  categories: string[]
  genres: string[]
  age?: "L" | "10"
  featured?: boolean
  /** Filme: 1 vídeo. Série: episódios por ordem. */
  videos: YtVideo[]
}

